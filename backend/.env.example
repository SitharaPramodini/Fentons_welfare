# Copy this file to backend/.env and replace every value with the real one.
# backend/.env is git-ignored; this example file is not.

PORT=4000

# --- MySQL -----------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=welfare_admin
DB_PASSWORD=change_me_before_deploying
DB_NAME=Welfare_Society_Fentons
DB_CONNECTION_LIMIT=10

# --- CORS ------------------------------------------------------------------
# Comma-separated list of origins allowed to call this API.
#
# In development any localhost port is accepted regardless of this list,
# because Vite moves to the next free port when 5173 is taken. Set
# NODE_ENV=production and this list becomes the only thing allowed.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- HR database (read only) ----------------------------------------------
# The Company staff record that sign-in and the employee list read from.
# Nothing is ever written to it.
DB_INTRANET_NAME=intranet

# --- Sessions --------------------------------------------------------------
# Must be at least 32 characters. The server refuses to start in production
# without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string_at_least_32_chars
SESSION_HOURS=8

# --- E-mail ---------------------------------------------------------------
# Where membership and loan applications are sent.
# SOCIETY_INBOX=yashod.sooriyapperuma@hayleysfentons.com
SOCIETY_INBOX=sitharapramodini@gmail.com
MAIL_FROM=Welfare Society of Fentons <no-reply@hayleysfentons.com>

# The site's own address, used to build the links inside e-mails.
SITE_URL=http://localhost:5173

# SMTP. Until these are filled in, every message is written to
# backend/outbox as a readable .eml file instead of being sent - nothing
# breaks and nothing is lost.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- The Society's office --------------------------------------------------
# HRIS numbers allowed to approve and decline applications. Comma-separated.
# 716876 is Ayodya Yashod Sooriyapperuma, Junior Executive - Human Resources.
ADMIN_HRIS=716876

# How long a decision link in an e-mail stays usable.
ACTION_LINK_DAYS=14
